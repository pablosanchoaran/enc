# Binance API — obtener en https://www.binance.com/en/my/settings/api-management
# En paper mode: read-only keys son suficientes
# En live mode: requiere permisos SPOT trading (NO habilitar withdrawals)
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Telegram bot — crear con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Chat ID — obtener con @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# Modo de ejecución: BACKTEST | PAPER | LIVE
EXECUTION_MODE=PAPER

# Capital inicial en EUR
INITIAL_CAPITAL=5000.0

# Ruta a la base de datos SQLite
DATABASE_URL=sqlite:///./data/cryptobot.db

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
